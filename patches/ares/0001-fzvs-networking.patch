+static std::unique_ptr<FZVSWindow> networkWindow;
+auto fzvsCreateUI() -> void {
+  if(!fzvs::client.active()) return;
+  networkWindow=std::make_unique<FZVSWindow>();
+  networkWindow->menu.setText("Multiplayer");
+  networkWindow->panel.setText("Players and diagnostics").onActivate([] {
+    networkWindow->setAlignment(presentation,Alignment::Center); networkWindow->setVisible(); networkWindow->setFocused();
+  });
+  auto& c=fzvs::client.config; auto area=Monitor::workspace(0);
+  int width=std::min(c.width,(int)area.width()),height=std::min(c.height+24,(int)area.height()-30);
+  int x=std::clamp(c.x,(int)area.x(),(int)(area.x()+area.width())-width);
+  int y=std::clamp(c.y,(int)area.y(),(int)(area.y()+area.height())-height);
+  presentation.setGeometry({(float)x,(float)y,(float)width,(float)height});
+}
+auto fzvsRefreshUI() -> void {
+  if(!networkWindow) return;
+  static uint32_t configurationRace=0;
+  static int configuredPlayers=0,configuredTrack=-1;
+  static uint64_t last=0; auto now=chrono::millisecond(); if(now-last<200) return; last=now;
+  auto v=fzvs::client.view(); auto& w=*networkWindow;
+  const char *colors[]={"Pink","Blue","Green","Yellow"};
+  string identity=v.player>=0 ? string{"YOU: P",v.player+1," • ",colors[v.player]," • ",fz_car_name(v.peers[v.player].car)} : "Connecting";
+  w.identity.setText(identity); presentation.setTitle({fzvs::client.config.label.c_str()," — ",identity});
+  presentation.statusLeft.setText({identity," | ",v.game.c_str()," | RTT ",(int)v.rtt," ms"});
+  string roster;
+  for(int i=0;i<4;i++) roster.append("P",i+1,i==v.player?" [YOU] ":" ",colors[i]," • ",fz_car_name(v.peers[i].car)," • ",fz_status_name(v.peers[i].status),
+    " • update age ",v.peers[i].age," ms",i==v.host?" [HOST]":"","\n");
+  w.roster.setText(roster);
+  if(configurationRace!=v.race || configuredPlayers!=v.expected || configuredTrack!=v.league*5+v.track) {
+    configurationRace=v.race; configuredPlayers=v.expected; configuredTrack=v.league*5+v.track;
+    w.players.item(v.expected-2).setSelected(); w.track.item(configuredTrack).setSelected();
+  }
+  w.apply.setEnabled(v.connected && v.player==v.host && v.phase==FZ_LOBBY);
+  w.next.setEnabled(v.connected && v.player==v.host && (v.phase==FZ_RESULTS || v.phase==FZ_LOBBY));
+  char metrics[512]; snprintf(metrics,sizeof(metrics),"RTT %.1f ms   Jitter %.1f ms   Estimated snapshot loss %.1f%%\nRX %.1f/s   TX %.1f/s   %.1f KiB/s   Emulation %.1f fps\nStale packets %llu   Control retries %llu",v.rtt,v.jitter,v.loss,v.rxRate,v.txRate,v.kbps,v.fps,(unsigned long long)v.stale,(unsigned long long)v.retries);
+  w.stats.setText(metrics);
+  char state[512]; snprintf(state,sizeof(state),"Race %u • Server: %s • Game: %s • Track %d/%d\nWRAM $54/$55/$56 = %02X/%02X/%02X • X/Y = %u/%u • Patched bytes %u",v.race,fz_phase_name(v.phase),v.game.c_str(),v.league,v.track,v.ram54,v.ram55,v.ram56,v.x,v.y,v.patches);
+  w.game.setText(state); w.events.setText(v.events.c_str());
+}
+auto fzvsInput(ares::Node::Input::Input node) -> bool {
+  auto button=node->cast<ares::Node::Input::Button>();
+  if(!button) return false;
+  auto& c=fzvs::client.config;
+  if(c.autoCar>=0) { button->setValue(fzvs::client.scriptedButton(node->name().data())); return true; }
+  button->setValue(0);
+  if(c.input=="none") return true;
+  lock_guard<recursive_mutex> lock(program.inputMutex);
+  std::string name=node->name().data();
+  if(c.input=="keyboard") {
+    if(!presentation.focused()) return true;
+    static const std::map<std::string,std::string> keys={{"Up","Up"},{"Down","Down"},{"Left","Left"},{"Right","Right"},{"B","Z"},{"A","X"},{"Y","A"},{"X","S"},{"L","Q"},{"R","W"},{"Start","Return"},{"Select","Space"}};
+    auto found=keys.find(name); if(found==keys.end()) return true;
+    for(auto& device:inputManager.devices) if(device->isKeyboard()) {
+      auto& group=device->group(HID::Keyboard::GroupID::Button);
+      for(unsigned i=0;i<group.size();i++) if(group.input(i).name()==found->second.c_str()) button->setValue(group.input(i).value()!=0);
+    }
+    return true;
+  }
+  // Gamepads use the user's normal Ares mappings, with a device filter in InputDigital.
+  return false;
+}
