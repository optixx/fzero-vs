--- /dev/null
+++ b/desktop-ui/fzvs.cpp
@@ -0,0 +1,133 @@
+#include "desktop-ui.hpp"
+#include <nall/hash/sha256.hpp>
+
+auto fzvsAttach() -> bool {
+  if(!emulator || emulator->name!="Super Famicom") { fzvs::client.failure("Multiplayer requires Super Famicom"); return false; }
+  ares::Node::Debugger::Memory ram,rom;
+  for(auto node:ares::Node::enumerate<ares::Node::Debugger::Memory>(emulator->root)) {
+    if(node->name()=="CPU WRAM") ram=node;
+    if(node->name()=="Cartridge ROM") rom=node;
+  }
+  if(!ram || !rom || ram->size()!=128*1024 || rom->size()!=512*1024) {
+    fzvs::client.failure("Unsupported ROM or missing emulator memory adapter"); return false;
+  }
+  std::vector<uint8_t> bytes(rom->size());
+  for(unsigned i=0;i<bytes.size();i++) bytes[i]=rom->read(i);
+  if(Hash::SHA256(bytes).digest()!="bf16c3c867c58e2ab061c70de9295b6930d63f29f81cc986f5ecae03e0ad18d2") {
+    fzvs::client.failure("ROM SHA-256 mismatch: F-Zero US original revision required"); return false;
+  }
+  fzvs::Memory memory;
+  memory.ram=[ram](uint32_t a) -> uint8_t { return a<ram->size() ? (uint8_t)ram->read(a) : 0; };
+  memory.rom=[rom](uint32_t a) -> uint8_t { return a<rom->size() ? (uint8_t)rom->read(a) : 0; };
+  memory.writeRam=[ram](uint32_t a,uint8_t v) { if(a<ram->size()) ram->write(a,v); };
+  memory.writeRom=[rom](uint32_t a,uint8_t v) { if(a<rom->size()) rom->write(a,v); };
+  memory.reset=[] { emulator->root->power(true); };
+  return fzvs::client.attach(std::move(memory));
+}
