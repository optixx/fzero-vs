+    const char *names[]={"Knight — Mute City I","Knight — Big Blue","Knight — Sand Ocean","Knight — Death Wind I","Knight — Silence",
+      "Queen — Mute City II","Queen — Port Town I","Queen — Red Canyon I","Queen — White Land I","Queen — White Land II",
+      "King — Mute City III","King — Death Wind II","King — Port Town II","King — Red Canyon II","King — Fire Field"};
+    for(auto name:names) { ComboButtonItem item{&track}; item.setText(name); }
+    apply.setText("Set race").onActivate([&] {
+      unsigned index=track.selected().offset(); fzvs::client.request(FZ_CONFIG,{(uint8_t)(players.selected().offset()+2),(uint8_t)(index%5),(uint8_t)(index/5)});
