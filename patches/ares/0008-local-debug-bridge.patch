+#pragma once
+
+#include <atomic>
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+class DebugBridge {
+public:
+  static constexpr uint32_t ProtocolVersion = 1;
+  static constexpr const char* BridgeVersion = "0.1.0";
+
+  DebugBridge() = default;
+  DebugBridge(const DebugBridge&) = delete;
+  auto operator=(const DebugBridge&) -> DebugBridge& = delete;
+
+  auto start(const std::string& socketPath) -> bool;
+  auto stop() -> void;
+  auto active() const -> bool { return _active.load(); }
+  auto pending() const -> bool { return _pending.load() != 0; }
+
+  // Called only by the emulator worker after the core has yielded at an SNES
+  // instruction boundary, or while already suspended there/no game is loaded.
+  auto processBoundary() -> void;
+
+  // Called while Program::Guard excludes the emulator worker.
+  auto gameLoaded() -> void;
+  auto gameUnloaded() -> void;
+
+  // Called on the emulator worker from Program::video().
+  auto captureFrame(const uint32_t* data, uint32_t pitch, uint32_t width, uint32_t height) -> void;
+
+private:
+  struct Request {
+    std::string line;
+    std::string response;
+    bool completed = false;
+    std::mutex mutex;
+    std::condition_variable condition;
+  };
+
+  struct Patch {
+    std::string id;
+    uint32_t offset = 0;
+    std::vector<uint8_t> original;
+    std::vector<uint8_t> replacement;
+  };
+
+  struct State {
+    std::string id;
+    std::string name;
+    std::string romSha256;
+    std::vector<uint8_t> data;
+  };
+
+  auto serverLoop() -> void;
+  auto clientLoop(int socket) -> void;
+  auto enqueue(const std::string& line) -> std::shared_ptr<Request>;
+  auto dispatch(const std::string& line) -> std::string;
+  auto failPending() -> void;
+  auto logEvent(const char* event, const std::string& detail = {}) const -> void;
+
+  std::atomic<bool> _active = false;
+  std::atomic<uint32_t> _pending = 0;
+  std::atomic<int> _listenSocket = -1;
+  std::atomic<int> _clientSocket = -1;
+  std::thread _serverThread;
+  std::string _socketPath;
+  std::mutex _queueMutex;
+  std::deque<std::shared_ptr<Request>> _queue;
+
+  bool _gameLoaded = false;
+  std::string _romName;
+  std::string _romSha256;
+  uint64_t _frameCounter = 0;
+  uint64_t _nextPatchId = 1;
+  uint64_t _nextStateId = 1;
+  uint64_t _nextCaptureId = 1;
+  std::map<std::string, Patch> _patches;
+  std::map<std::string, State> _states;
+  std::vector<uint32_t> _frame;
+  uint32_t _frameWidth = 0;
+  uint32_t _frameHeight = 0;
+};
+
+extern DebugBridge debugBridge;
